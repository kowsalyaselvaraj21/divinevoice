# Temple Notification System Environment Variables
# Copy this file to .env and fill in your actual values

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Webhook Configuration
WEBHOOK_URL=https://your-domain.com/api/webhooks

# WhatsApp Business API Configuration (Optional)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Monitoring Configuration (Optional)
GRAFANA_PASSWORD=your_grafana_admin_password_here

# Application Configuration
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080

# Logging Configuration
LOGGING_LEVEL_COM_TEMPLE_NOTIFICATION=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN

# Notification Configuration
NOTIFICATION_VOICE_MAX_CONCURRENT_CALLS=10
NOTIFICATION_VOICE_RETRY_ATTEMPTS=3
NOTIFICATION_SMS_RETRY_ATTEMPTS=2
NOTIFICATION_WHATSAPP_RETRY_ATTEMPTS=2
